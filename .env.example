# Backend API Base URL (dev server only)
# Used when running the Vite dev server; production build uses the same origin as the page.
# Default: http://localhost:8000
# VITE_API_BASE_URL=http://192.168.10.121:8000

# Frontend logging profile
# debug  -> debug/info/warn/error
# test   -> warn/error (CI-friendly)
# deploy -> warn/error (production-safe)
# VITE_LOG_PROFILE=debug

# Cloudflare Turnstile site key (public, for CAPTCHA alternative on register and forgot-password forms)
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAACWncPZW1kU5S-fO

# Google Sign-In (GIS): OAuth 2.0 Web client ID from Google Cloud Console.
# Add each app origin under Authorized JavaScript origins (e.g. http://localhost:5173).
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Canonical site origin for SEO (canonical URLs, sitemap.xml, Open Graph).
# Production: https://core.flit-pkm.com
# VITE_SITE_ORIGIN=https://core.flit-pkm.com
