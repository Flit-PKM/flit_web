{
	"name": "flit-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:force": "vite dev --force",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:format && npm run lint:eslint",
		"lint:eslint": "eslint .",
		"lint:format": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:unit": "vitest run src/lib/utils",
		"test:dom": "vitest run src/lib/components src/routes",
		"test:coverage": "vitest run --coverage",
		"ci:quick": "npm run check && npm run lint && npm run test:run",
		"ci:check": "npm run check && npm run lint && npm run test:coverage"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.17.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^22.10.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"jsdom": "^25.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.15.0",
		"svelte-check": "^4.1.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.0",
		"vite": "^6.0.3",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"@tiptap/core": "^3.22.5",
		"@tiptap/extension-placeholder": "^3.22.5",
		"@tiptap/extension-table": "^3.22.5",
		"@tiptap/extension-table-cell": "^3.22.5",
		"@tiptap/extension-table-header": "^3.22.5",
		"@tiptap/extension-table-row": "^3.22.5",
		"@tiptap/extension-task-item": "^3.22.5",
		"@tiptap/extension-task-list": "^3.22.5",
		"@tiptap/markdown": "^3.22.5",
		"@tiptap/pm": "^3.22.5",
		"@tiptap/starter-kit": "^3.22.5",
		"dompurify": "^3.3.1",
		"marked": "^17.0.1"
	}
}
